{
  "$schema": "https://raw.githubusercontent.com/webpro/knip/v6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "src/preamble.ts!",
        "src/theme.ts!",
        "src/views/menu.tsx!",
        "src/views/index.tsx!",
        "src/embedded/index.tsx!",
        "src/service-worker.ts!",
        "**/*.test.{ts,tsx,js,jsx}!",
        "**/*.spec.{ts,tsx,js,jsx}!",
        "**/*.story.{ts,tsx,js,jsx}!",
        "**/*.stories.{ts,tsx,js,jsx}!",
        "**/*-stories.{ts,tsx,js,jsx}!",
        "**/*.testHelpers.{ts,tsx,js,jsx}!",
        "spec/*.{ts,tsx,js,jsx}!",
        "spec/**/*.{ts,tsx,js,jsx}!",
        "**/test/**/*.{ts,tsx,js,jsx}!",
        "**/tests/**/*.{ts,tsx,js,jsx}!",
        "**/__tests__/**/*.{ts,tsx,js,jsx}!",
        "**/story/**/*.{ts,tsx,js,jsx}!",
        "**/stories/**/*.{ts,tsx,js,jsx}!",
        "**/__stories__/**/*.{ts,tsx,js,jsx}!"
      ],
      "project": [
        "src/**/*.{ts,tsx,js,jsx,mdx}!"
      ],
      "webpack": false
    }
  },
  "ignoreWorkspaces": [
    "packages/*",
    "plugins/*"
  ]
}
